{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bluewave-site-preview",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "vars": {
    "LEADS_ENABLED": "false",
    "EVENTS_ENABLED": "false",
    "NEWSLETTER_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [{"name":"LEAD_GUARD","class_name":"LeadGuard"}]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["LeadGuard"]}]
}
