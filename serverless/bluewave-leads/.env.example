# Inventaire des variables et secrets. Aucune valeur réelle ici.
# Les secrets ne sont jamais versionnés : ils sont posés au runtime.

# --- Brevo : carnet de contacts et envois transactionnels ---
BREVO_API_KEY=
BREVO_LEADS_LIST_ID=
BREVO_ACK_TEMPLATE_ID=
BREVO_INTERNAL_TEMPLATE_ID=
BLUEWAVE_INTERNAL_EMAIL=contact@example.invalid
ALLOWED_ORIGIN=https://example.invalid
BLUEWAVE_SITE_URL=https://example.invalid

# --- Activation des canaux. Tous fermés pendant la préparation. ---
LEADS_ENABLED=false
EVENTS_ENABLED=false
NEWSLETTER_ENABLED=false
TURNSTILE_ENABLED=false
PUBLIC_INDEXABLE=false

# --- Secrets de runtime ---
# Empreinte de la garde anti-abus. Au moins 32 caractères.
GUARD_HMAC_KEY=
# Clé SECRÈTE Turnstile. Jamais côté navigateur, jamais dans un build.
# La clé PUBLIQUE est fournie à la construction de l'artefact
# (build_production_dist.py --turnstile-site-key).
TURNSTILE_SECRET_KEY=
# Signature des jetons de confirmation de la lettre de veille. Au moins
# 32 caractères. Nécessaire seulement si le canal est un jour ouvert.
NEWSLETTER_TOKEN_SECRET=

# --- Conservation ---
# Vide : aucune purge des demandes. Aucune durée n'est choisie par défaut.
LEAD_RETENTION_DAYS=

# --- Hors .env : bindings Cloudflare ---
# LEAD_GUARD (Durable Object), CONVERSION_DB et LEADS_DB (D1, deux bases
# distinctes). Codes de campagne préapprouvés, sans identité : ALLOWED_CAMPAIGNS=
